local shinyToggle = false
HackSection:NewToggle("Become Shiny (Visual Fix)", "Включить неоновое золотое свечение", function(state)
    shinyToggle = state
    if state and lp.Character then
        addLog("Активирован визуальный Шайни-режим")
        for _, part in pairs(lp.Character:GetChildren()) do
            if part:IsA("BasePart") then
                local box = Instance.new("SelectionBox")
                box.Name = "ShinyGlow"
                box.Adornee = part
                box.Color3 = Color3.fromRGB(255, 215, 0)
                box.LineThickness = 0.04
                box.Parent = part
                
                local aura = Instance.new("ForceField")
                aura.Name = "ShinyAura"
                aura.Visible = true
                aura.Parent = lp.Character
            end
        end
    else
        addLog("Визуальный Шайни-режим отключен")
        if lp.Character then
            for _, v in pairs(lp.Character:GetDescendants()) do
                if v.Name == "ShinyGlow" or v.Name == "ShinyAura" then v:Destroy() end
            end
        end
    end
end)

HackSection:NewButton("Emit Legendary Particles", "Заспавнить искры легендарок на себе", function()
    addLog("Запуск легендарных эффектов...")
