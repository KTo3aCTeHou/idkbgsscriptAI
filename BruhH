HackSection:NewButton("Unlock Passes (Upvalues)", "Локальный взлом (getgc метод)", function()
    addLog("Запуск getgc перебора памяти...")
    for _, f in pairs(getgc()) do
        if type(f) == "function" and islclosure(f) then
            local upvals = debug.getupvalues(f)
            for i, v in pairs(upvals) do
                if type(v) == "table" and (rawget(v, "Quantum Gum") ~= nil or rawget(v, "+500 Slots") ~= nil) then
                    for pName, val in pairs(v) do if type(val) == "boolean" then v[pName] = true end end
                    debug.setupvalue(f, i, v)
                end
            end
        end
    end
    addLog("Геймпассы успешно хакнуты!")
end)

