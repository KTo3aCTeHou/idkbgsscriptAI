-- === ФУНКЦИЯ СТИЛЯ (ПОЛНОЦЕННЫЙ КОТИК-БЭКГРАУНД НА ВЕСЬ ФОН ОКНА) ===
local function ApplyCustomStyle(id)
    pcall(function()
        local coreGui = game:GetService("CoreGui")
        
        -- Полностью зачищаем старые косячные слои
        local oldCat = coreGui:FindFirstChild("nothing_club_background")
        if oldCat then oldCat:Destroy() end
        
        for _, gui in pairs(coreGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui:FindFirstChild("Main") then
                local main = gui.Main
                if main:FindFirstChild("CustomBG") then main.CustomBG:Destroy() end
                
                -- Котик красиво растягивается строго внутри фрейма Main как полноценный бг!
                local bg = Instance.new("ImageLabel", main)
                bg.Name = "CustomBG"
                bg.Size = UDim2.new(1, 0, 1, 0)
                bg.Position = UDim2.new(0, 0, 0, 0)
                bg.ZIndex = 0 -- Кидаем в самый низ подложки
                bg.BackgroundTransparency = 1
                bg.Image = "rbxassetid://" .. id
                bg.ImageTransparency = 0.25 -- Легкая прозрачность для стиля
                bg.ScaleType = Enum.ScaleType.Stretch
                Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 10)
                
                -- Делаем окна KavoUI просвечивающими, чтобы котик работал как полноценный фон
                for _, child in pairs(main:GetDescendants()) do
                    if child:IsA("Frame") or child:IsA("ScrollingFrame") then
                        child.BackgroundTransparency = 0.85
                        child.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
                    elseif child:IsA("TextButton") and child.Name ~= "AI" then
                        child.BackgroundTransparency = 0.5
                        child.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
                    end
                end
            end
        end
    end)
end

