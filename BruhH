local ScriptLogSection = Settings:NewSection("Script Activity Logs")

-- Создаем интерактивные ярлыки для вывода текста
local robloxConsoleLabel = ConsoleSection:NewLabel("Консоль запущена. Ожидание системных логов...")
local scriptActivityLabel = ScriptLogSection:NewLabel("Лог скрипта: Ожидание старта...")

-- Хакерский перехватчик системной консоли Roblox (Перенаправляем логи в меню)
task.spawn(function()
    LogService.MessageOut:Connect(function(message, messageType)
        -- Превращаем тип сообщения в красивый текст
        local msgTypeStr = "[INFO]"
        if messageType == Enum.MessageType.MessageError then
            msgTypeStr = "[⛔ ERROR]"
        elseif messageType == Enum.MessageType.MessageWarning then
            msgTypeStr = "[⚠️ WARN]"
        end
        -- Обновляем текст в нашей встроенной консоли (показываем последние 60 символов для компактности)
        local cleanMsg = message:sub(1, 55)
        robloxConsoleLabel:UpdateLabel(msgTypeStr .. " " .. cleanMsg)
    end)
end)

-- Функция для добавления логов самого скрипта
local function logScript(text)
    local osTime = os.date("%X") -- Берем текущее время на ноутбуке
    scriptActivityLabel:UpdateLabel("[" .. osTime .. "] " .. text)
end

-- === СЕТЕВОЙ ФИЛЬТР ЛЕГЕНДАРОК ===
if REMOTE_EVENT and REMOTE_EVENT:IsA("RemoteEvent") then
    REMOTE_EVENT.OnClientEvent:Connect(function(action, ...)
        if autoHatch and (action == "DisplayLegendaryInChat" or action == "DisplayLegendaryHatInChat") then
            return 
        end
    end)
end

-- === ХАКЕРСКИЙ ПЕРЕХВАТЧИК СЕРВЕРНОЙ ПАУЗЫ ===
if REMOTE_FUNC and REMOTE_FUNC:IsA("RemoteFunction") then
    REMOTE_FUNC.OnClientInvoke = function(action, ...)
        if action == "DataChanged" and autoHatch then
            task.wait(serverDebounceTime)
            logScript("Сервер заморожен через InvokeClient (DataChanged)")
            return true
        end
        return true
    end
end

-- === ХУК ГРАФИКИ И АВТО-СКИПА ===
task.spawn(function()
    local eggServiceModule = rs.Assets.Modules:FindFirstChild("EggService")
    if eggServiceModule then
        local eggService = require(eggServiceModule)
        local oldHatchEgg = eggService.HatchEgg
        local oldMultiHatchEgg = eggService.MultiHatchEgg
        
        eggService.HatchEgg = function(...)
            if bypass3DRender and autoHatch then return end
            return oldHatchEgg(...)
        end
        
        eggService.MultiHatchEgg = function(...)
            if bypass3DRender and autoHatch then return end
            return oldMultiHatchEgg(...)
        end
    end
    
    game:GetService("CoreGui").ChildAdded:Connect(function(child)
        if instantSkipUI and child.Name == "AI_Draggable_UI" then return end
        if instantSkipUI and lp.PlayerGui:FindFirstChild("ScreenGui") then
            local screenGui = lp.PlayerGui.ScreenGui
            local petHatch = screenGui:FindFirstChild("PetHatch") or screenGui:FindFirstChild("MultiPetHatch")
            if petHatch and petHatch:FindFirstChild("Skip") then
                pcall(function()
                    local skipBtn = petHatch.Skip
                    if skipBtn.Visible then
                        for _, c in pairs(getconnections(skipBtn.MouseButton1Down)) do c:Fire() end
                        logScript("Анимация яйца успешно пропущена (Instant Skip)")
                    end
                end)
            end
        end
    end)
end)

