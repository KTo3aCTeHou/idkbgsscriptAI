        local effectsFolder = rs.Assets:FindFirstChild("LegendaryEffects")
        if effectsFolder and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
            for _, effect in pairs(effectsFolder:GetChildren()) do
                local clone = effect:Clone()
