function EquipBest(REvent,RFunction,plr)
	local orderedList = function(a,b)
		a[9]=a[9] or 0
		b[9]=b[9] or 0
		local s1 = PetBuffsService:GetBuffs(a)["Bubbles"]
		local s2 = PetBuffsService:GetBuffs(b)["Bubbles"]

		if s1 > s2 then
			return true
		elseif s1 < s2 then
			return false
		end
		local _a = a[3]:lower()
		local _b = b[3]:lower()

		if _a == _b then
			return a[1] < b[1]
		end
		return _a < _b
	end

	local plrData = GetPlayerData(REvent,RFunction,plr)
	local ownedPasses = GetPlayerPasses(REvent,RFunction,plr)

	table.sort(plrData["PETS"],orderedList)

	local MaxEquip = 8 + (ownedPasses["+5 Pets"] == true and 5 or 0)
	MaxEquip = MaxEquip + (ownedPasses["+50 Pets"] == true and 50 or 0)
	MaxEquip = (ownedPasses["Infinite Pets"] == true and math.huge or MaxEquip)
	if not plrData["EXTRA_PETS"] then
		plrData["EXTRA_PETS"] = 0
	end
	MaxEquip = MaxEquip + plrData["EXTRA_PETS"]

	local EquipCounter = 1

	for i,v in pairs(plrData["PETS"]) do
		if v[6] then
			v[6] = false

			for _,b in pairs(game.Players:GetPlayers()) do
				pcall(function()
					--[[
					if not game.ReplicatedStorage:FindFirstChild(tostring(b.UserId).."Event") then
						continue
					end
					]]--
					game.ReplicatedStorage[tostring(b.UserId).."Event"]:FireAllClients("DespawnPet",plr,v[1])
				end)
			end
		end

		if EquipCounter <= MaxEquip then
			EquipCounter += 1

			v[6] = true

			for _,b in pairs(game.Players:GetPlayers()) do
				pcall(function()
					game.ReplicatedStorage[tostring(b.UserId).."Event"]:FireAllClients("SpawnPet",plr,v[3],v[1],v[8],v[10])
				end)
			end
		end
	end

	UpdateData(REvent,RFunction,plr,plrData)
end

