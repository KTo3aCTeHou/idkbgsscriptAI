function TradeAcceptRequest(REvent,RFunction,plr,sender)
	if not table.find(TradeRequests[sender],plr) then return end

	TradeRequests[sender] = {}
	TradeRequests[plr] = {}

	local plrInTrade

	for i,v in pairs(Trades) do
		if v.Player0 == plr or v.Player0 == sender then plrInTrade = true end
		if v.Player1 == plr or v.Player1== sender then plrInTrade = true end
	end

	if plrInTrade then
		return
	end

	local p0 = GetPlayerData(nil,nil,sender)
	local p1 = GetPlayerData(nil,nil,plr)

	local Data = {}

	Data["Player0"] = sender
	Data["Player1"] = plr

	Data["Inventory0"] = {}
	Data["Inventory1"] = {}

	Data["Inventory0"].Pets = p0["PETS"]
	Data["Inventory1"].Pets = p1["PETS"]

	Data["Inventory0"].Hats = p0["HATS"]
	Data["Inventory1"].Hats = p1["HATS"]

	Data["Offer0"] = {}
	Data["Offer1"] = {}

	Data["Space0"] = {
		Pets = math.huge,
		Hats = math.huge,
	}
	Data["Space1"] = {
		Pets = math.huge,
		Hats = math.huge,
	}

	Data["Stage0"] = 0
	Data["Stage1"] = 0

	Data["Status0"] = 0
	Data["Status1"] = 0

	table.insert(Trades,Data)

	game.ReplicatedStorage[tostring(plr.UserId).."Event"]:FireAllClients("TradeOpened",Data)
	game.ReplicatedStorage[tostring(sender.UserId).."Event"]:FireAllClients("TradeOpened",Data)

	TradeDatas[plr] = "Trading"
	TradeDatas[sender] = "Trading"

	return Data
end

