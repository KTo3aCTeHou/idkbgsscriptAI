function CollectPrize(REvent,RFunction,plr,list,i)
	local plrData = GetPlayerData(REvent,RFunction,plr)
	local plrPasses = GetPlayerPasses(REvent,RFunction,plr) 
	local indexName = "CLAIMED_HATCH_REWARDS"
	if list == "Bubbles" then
		indexName = "CLAIMED_BUBBLE_REWARDS"
	end
	if table.find(plrData[indexName],i) then
		return
	end
	if PrizeModule[list][i].Requirement <= plrData[index.CurrencyIndex(list)] then
		if PrizeModule[list][i]["PetEquip"] then
			table.insert(plrData[indexName],i)
			if not plrData["EXTRA_PETS"] then
				plrData["EXTRA_PETS"] = 0
			end
			plrData["EXTRA_PETS"]+=PrizeModule[list][i]["PetEquip"]
		else
			table.insert(plrData[indexName],i)

			local petName = PrizeModule[list][i]["Reward"]
			local petData = {
				[1] = game:GetService("HttpService"):GenerateGUID(false),
				[2] = petName,
				[3] = petName,
				[4] = (plrPasses["Max Level / Enchant"] and 25) or 0,
				[5] = 0,
				[6] = false,
				[7] = false,
				[8] = PrizeModule[list][i]["Shiny"],
				[9] = (plrPasses["Max Level / Enchant"] and 40) or 0,
				[10] = false,
			}

			table.insert(plrData["PETS"],petData)
		end
	end
	UpdateData(REvent,RFunction,plr,plrData)
end

