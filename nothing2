			game.ReplicatedStorage[tostring(tradeData.Player1.UserId).."Event"]:FireAllClients("TradeCompleted")

			TradeDatas[tradeData.Player0] = "Trade"
			TradeDatas[tradeData.Player1] = "Trade"

			table.remove(Trades,tradeIndex)
		end
	end
