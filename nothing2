function HandleDevProductPurchase(reciept)
	local Player = game.Players:GetPlayerByUserId(reciept.PlayerId)
	local ProductID = reciept.ProductId
	local BoostProduct = nil
	local EggName = nil

	local Cost = reciept.CurrencySpent
	local plrData = GetPlayerData(nil,nil,Player)

	if not plrData["DEV_PRODUCT_ROBUX"] then
		plrData["DEV_PRODUCT_ROBUX"] = 0
	end

	plrData["DEV_PRODUCT_ROBUX"] += Cost

	UpdateData(game.ReplicatedStorage[tostring(Player.UserId).."Event"],game.ReplicatedStorage[tostring(Player.UserId).."Function"],Player,plrData)
	for i,v in pairs(BoostModule) do
		if v.Product1 == ProductID then BoostProduct = {i,v.Duration1,v.Duration1} end
		if v.Product2 == ProductID 	then BoostProduct = {i,v.Duration2,v.Duration2} end
	end

	for a,b in pairs(EggModule.Products) do
		if b["Product"] == ProductID then
			EggName = a
		end
	end

	if BoostProduct then
		local bIndex
		for i = 1, #plrData["BOOSTS"] do
			if plrData["BOOSTS"][i][1]==BoostProduct[1] then
				bIndex = i
			end
		end
		if not bIndex then
			table.insert(plrData["BOOSTS"],BoostProduct)
		else
			plrData["BOOSTS"][bIndex][2]+=BoostProduct[2]
			plrData["BOOSTS"][bIndex][3]+=BoostProduct[2]
		end

		UpdateData(game.ReplicatedStorage[tostring(Player.UserId).."Event"],game.ReplicatedStorage[tostring(Player.UserId).."Function"],Player,plrData)
	end

	if EggName then
		UpdateData(game.ReplicatedStorage[tostring(Player.UserId).."Event"],game.ReplicatedStorage[tostring(Player.UserId).."Function"],Player,EggService:GivePetFromEgg(Player,EggName,ProductID,1,nil,plrData,1))
	end

	return Enum.ProductPurchaseDecision.PurchaseGranted
end

