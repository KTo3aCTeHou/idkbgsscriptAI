Network.OnServerInvoke = function(plr,n)
	local DS = game:GetService("DataStoreService")
	local BanDS = DS:GetDataStore("Player_Bans1")

	local BanList = BanDS:GetAsync("List")

	if not BanList then BanList = {} end
	for _,BannedPlayer in pairs(BanList) do
		print(BannedPlayer)
		if BannedPlayer.UserId == plr.UserId then
			plr:Kick(BannedPlayer.BanReason or "")
			return nil
		end
	end

	if n then Services:SetService("Network",n) end
	DataService:LoadFirst(plr)
	local REvent = Instance.new("RemoteEvent",game:GetService("ReplicatedStorage"))
	local RFunction = Instance.new("RemoteFunction",game:GetService("ReplicatedStorage"))
	local ChatBubble = script.ChatBubble:Clone()

	ChatBubble.Parent = plr.Character.Head

	REvent.Name = tostring(plr.UserId).."Event"
	RFunction.Name = tostring(plr.UserId).."Function"

	TradeRequests[plr] = {}
	TradeDatas[plr] = "Trade"

	Debug:HookRemote(REvent)
	Debug:HookRemote(RFunction)

	game.Players.PlayerRemoving:Connect(function(p)
		if p.UserId == plr.UserId then
			REvent:Destroy()
			RFunction:Destroy()
		end
	end)

	REvent.OnServerEvent:Connect(function(plr,Job,...)
		if isStudio then
			print(Job,...)
		end
		local p = {...}
		local JobFunction = Jobs[Job]
		if not RunningTasks[plr] then RunningTasks[plr] = {} end
		if RunningTasks[plr][Job] == true then
			if NoDebounceTasks[Job] == nil then
				return
			end
		end
		if JobFunction then
			RunningTasks[plr][Job] = true
			local notResetTask = true
			delay(1.5,function()
				if notResetTask then
					RunningTasks[plr][Job] = false
				end
			end)
			JobFunction(REvent,RFunction,plr,unpack(p))
			notResetTask = false
			RunningTasks[plr][Job] = false
		else
			print(Job,...)
		end
	end)

	RFunction.OnServerInvoke = function(plr,Job,...)
		if isStudio then
			print(Job,...)
		end
		local JobFunction = Jobs[Job]
		if not RunningTasks[plr] then RunningTasks[plr] = {} end
		if RunningTasks[plr][Job] == true then
			if NoDebounceTasks[Job] == nil then
				return
			end
		end
		if JobFunction then
			RunningTasks[plr][Job] = true
			local notResetTask = true
			delay(5,function()
				if notResetTask then
					RunningTasks[plr][Job] = false
				end
			end)
			local ReturnedValue = JobFunction(REvent,RFunction,plr,...)
			notResetTask = false
			RunningTasks[plr][Job] = false
			return ReturnedValue
		else
			print(Job,...)
		end
	end

	spawn(function() BubbleService:InitializeServer(plr) end)
	spawn(function() ChestLayerService:InitializeServer() end)
	spawn(function() EggService:InitializeServer() end)

	return REvent, RFunction
end

