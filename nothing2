function MakePetDarkmatter(REvent,RFunction,plr,petid)
	local plrData = GetPlayerData(REvent,RFunction,plr)
	local plrPasses = GetPlayerPasses(REvent,RFunction,plr)
	local CollectedPets = setmetatable({},{__index={}})
	local petName
	for i,v in pairs(plrData["PETS"]) do
		if v[1] == petid then petName = v[2] end
	end
	local petsCollected = 0
	for i,v in pairs(plrData["PETS"]) do
		if v[2] == petName and v[8] and not v[10] and not table.find(CollectedPets,v[1]) then
			if petsCollected >= 10 then continue end
			table.insert(CollectedPets,v[1])
			petsCollected+=1
		end
	end
	if petsCollected == 10 then
		local petData = {
			[1] = game:GetService("HttpService"):GenerateGUID(false),
			[2] = petName,
			[3] = petName,
			[4] = (plrPasses["Max Level / Enchant"] and 25) or 0,
			[5] = 0,
			[6] = false,
			[7] = false,
			[8] = false,
			[9] = (plrPasses["Max Level / Enchant"] and 40) or 0,
			[10] = true,
		}
		plrData["PETS"] = removeguids(plr,plrData["PETS"],CollectedPets)
		table.insert(plrData["PETS"],petData)
	else
		return
	end

	UpdateData(REvent,RFunction,plr,plrData)
end

