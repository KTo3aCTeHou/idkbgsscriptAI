function removeguids(plr,pets,guids)
	repeat
		local foundItems = 0
		for i,v in pairs(pets) do
			if table.find(guids,v[1]) then
				if v[6] then
					for _,b in pairs(game.Players:GetPlayers()) do
						pcall(function()
							game.ReplicatedStorage[tostring(b.UserId).."Event"]:FireAllClients("DespawnPet",plr,v[1])
						end)
					end
				end
				table.remove(pets,i)
				foundItems+=1
			end
		end
	until foundItems == 0
	return pets
end

