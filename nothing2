function BuyShopItem(REvent,RFunction,plr,location,itemtype,item)
	local Flavours = require(game.ReplicatedStorage.Assets.Modules.ItemDataService.ShopModule:FindFirstChild(location))
	local plrData = GetPlayerData(REvent,RFunction,plr)

	if table.find(plrData[Flavours.InventoryIndex], item) then
		return false
	end

	local ItemCost, ItemCurrency

	for i,v in pairs(Flavours) do
		if type(v)=="table" and v.Name==item then
			ItemCost, ItemCurrency = v.Cost[1], v.Cost[2]
		end
	end

	if plrData[index.CurrencyIndex(ItemCurrency)] >= ItemCost then
		table.insert(plrData[Flavours.InventoryIndex],item)
		plrData["EQUIPPED_ITEMS"][Flavours.EquippedIndex] = item
	end

	UpdateData(REvent,RFunction,plr,plrData)

	return true
end

