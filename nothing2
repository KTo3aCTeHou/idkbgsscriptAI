function BlowBubble(REvent,RFunction,plr)
	if BlowBubbleDebounce[plr.Name] == true then
		return
	end
	BlowBubbleDebounce[plr.Name] = true

	local FlavourModule = require(game.ReplicatedStorage.Assets.Modules.ItemDataService.FlavorModule)
	local GumModule = require(game.ReplicatedStorage.Assets.Modules.ItemDataService.GumModule)

	local plrData = GetPlayerData(REvent,RFunction,plr)

	local bubbleIncrease = BubbleIncreases[plr.Name]
	local Bubbles = plrData["BUBBLE_SIZE"]
	local Gum = plrData["EQUIPPED_ITEMS"][2]

	if not bubbleIncrease then
		local Flavour = plrData["EQUIPPED_ITEMS"][1]
		local Face = plrData["EQUIPPED_ITEMS"][3]
		local equipped = DataService:GetPlayerData(plr, index.EQUIPPED_ITEMS)
		local increase = FlavorModule[Flavour].BubbleIncrease
		local increase2 = FaceModule[Face].BubbleIncrease
		local PetBuffs = PetBuffsService:GetAllBuffs(plr)
		PetBuffs = PetBuffs.Bubbles

		increase = increase + PetBuffs + increase2
		bubbleIncrease = increase

		BubbleIncreases[plr.Name] = bubbleIncrease
	end

	local NewSize = Bubbles + bubbleIncrease

	if NewSize >= GumModule[Gum].AirCapacity then
		NewSize = GumModule[Gum].AirCapacity
	end

	local plrBubble

	for _,v in pairs(workspace.Bubbles:GetChildren()) do
		if v.Player.Value == plr.Name then
			plrBubble = v
		end
	end

	if not plrBubble then
		BubbleService:CreateBubble(plr,0)
	end

	plrBubble.Amount.Value = NewSize
	plrBubble.RealAmount.Value = NewSize

	RFunction:InvokeClient(plr,"SetGravity",NewSize)
	RFunction:InvokeClient(plr,"BlowBubble")

	plrData["BUBBLES_BLOWN"] += bubbleIncrease

	local PetsEquipped = (function()
		local n = 0
		for i,v in pairs(plrData["PETS"]) do
			if n > 1 then
				return n
			end
			if v[6] then
				n = n + 1
			end
		end
		return n
	end)()
	
	if PetsEquipped <= 1 then
		plrData["SINGLE_BUBBLES_BLOWN"] = plrData["SINGLE_BUBBLES_BLOWN"] + bubbleIncrease
	end
	
	plrData["BUBBLE_SIZE"] = NewSize

	local plrName = plr.Name

	delay(0.3,function()
		BlowBubbleDebounce[plrName] = false
	end)

	UpdateStat(REvent,RFunction,plr,"BUBBLES_BLOWN",plrData["BUBBLES_BLOWN"])
	UpdateStat(REvent,RFunction,plr,"SINGLE_BUBBLES_BLOWN",plrData["SINGLE_BUBBLES_BLOWN"])
	UpdateStat(REvent,RFunction,plr,"BUBBLE_SIZE",plrData["BUBBLE_SIZE"])
end

function PurchaseEgg(REvent,RFunction,plr,egg,multi)
	if EggHatchDebounce[plr] then return end

	if game:GetService("ServerStorage"):FindFirstChild(egg) then
		plr:Kick()
		return
	end

	local plrData = GetPlayerData(REvent,RFunction,plr)
	local mInc = 1

	if multi then mInc = 3  end

	local EggModule = require(game.ReplicatedStorage.Assets.Modules.ItemDataService.EggModule)
	local CrateModule = require(game.ReplicatedStorage.Assets.Modules.ItemDataService.CrateModule)
	local eggData = EggModule[egg]
	local hatData = CrateModule[egg]

	local eggPrice

	if eggData then
		eggPrice = eggData["Cost"]
	end

	if hatData then
		eggPrice = hatData["Cost"]
	end

	local maxSlots = GetMaxSlots.Pets(DataService:GetOwnedPasses(plr))

	if #plrData["PETS"]+mInc>=maxSlots then
		return
	end

	if not eggPrice then eggPrice = {"Coins", 0} end

	local eggCurrency = index.CurrencyIndex(eggPrice[1])

	if not (plrData[eggCurrency] >= eggPrice[2] * mInc) then return end

	plrData[eggCurrency] = plrData[eggCurrency] - (eggPrice[2] * mInc)
	plrData["EGGS_OPENED"] = plrData["EGGS_OPENED"] + mInc
	EggHatchDebounce[plr] = true

	local speedDiv = BoostService:GetBoosts(plr)["2xHatchSpeed"] == true and 1.75 or 1

	if DataService:GetOwnedPasses(plr)["Fast Hatch"] then speedDiv *= 1.75 end

	if Is2xSpeedEnabled() then speedDiv *= 2 end

	speedDiv*=game.ReplicatedStorage.Assets.AdminData.SpeedIncrease.Value

	delay(5.5/speedDiv,function()
		EggHatchDebounce[plr] = nil
	end)

	if EggHatchDebounce[plr] then
		RFunction:InvokeClient(plr,"DataChanged", eggCurrency, plrData[eggCurrency])
		local plrData = EggService:GivePetFromEgg(plr, egg, nil, mInc, plrData, GetPlayerPasses(REvent,RFunction,plr))
		UpdateData(REvent,RFunction,plr,plrData,false,false,true)
		PetLevelService:AddXP(plr,math.random(3000,30000))
	end
end

function EquipPet(REvent,RFunction,plr,petid)
	local plrData = GetPlayerData(REvent,RFunction,plr)
	local ownedPasses = GetPlayerPasses(REvent,RFunction,plr)

	if not plrData["EQUIPPED_PETS_COUNT"] then
		plrData["EQUIPPED_PETS_COUNT"] = 0
	end

	local MaxEquip = 8 + (ownedPasses["+5 Pets"] == true and 5 or 0)
	MaxEquip = MaxEquip + (ownedPasses["+50 Pets"] == true and 50 or 0)
	MaxEquip = (ownedPasses["Infinite Pets"] == true and math.huge or MaxEquip)
	if not plrData["EXTRA_PETS"] then
		plrData["EXTRA_PETS"] = 0
	end
	MaxEquip = MaxEquip + plrData["EXTRA_PETS"]

	local EquipCounter = 0
	for _,v in pairs(plrData["PETS"]) do
		if v[6] then
			EquipCounter+=1
		end
	end

	if EquipCounter >= MaxEquip then
		return
	end

	for _,v in pairs(plrData["PETS"]) do
		if v[1]==petid and v[6] == false then
			v[6] = true
			for _,b in pairs(game.Players:GetPlayers()) do
				pcall(function()
					game.ReplicatedStorage[tostring(b.UserId).."Event"]:FireAllClients("SpawnPet",plr,v[3],petid,v[8],v[10])
				end)
			end
		end
	end

	UpdateData(REvent,RFunction,plr,plrData)
end

