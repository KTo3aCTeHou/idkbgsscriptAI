function OptimizeData(plr,data)
	if not data then data = DataService:GetPlayerData(plr) end
	local d = {
		"BUBBLES_BLOWN",
		"BUBBLE_SIZE"
	}

	repeat
		local foundProblems = 0
		local index = 0
		for i,v in pairs(data) do
			if table.find(d,v) then
				data[i] = nil
				foundProblems+=1
			end
		end
	until foundProblems == 0

	DataService:SetPlayerData(plr,data)

	return data
end

function UpdateData(REvent,RFunction,plr,data,dont_update,ignore_pets,update_pets)
	data["SET_LUCK"] = game:GetService("ReplicatedStorage").Assets.AdminData.LuckIncrease.Value
	local Flavour = data["EQUIPPED_ITEMS"][1]
	local Face = data["EQUIPPED_ITEMS"][3]
	local equipped = DataService:GetPlayerData(plr, index.EQUIPPED_ITEMS)
	local increase = FlavorModule[Flavour].BubbleIncrease
	local increase2 = FaceModule[Face].BubbleIncrease
	local PetBuffs, PetsEquipped = PetBuffsService:GetAllBuffs(plr)

	PetBuffs = PetBuffs.Bubbles
	increase = increase + PetBuffs + increase2

	BubbleIncreases[plr.Name] = increase

	spawn(function()
		for i,v in pairs(index.Leaderstats) do
			plr.leaderstats:FindFirstChild(i).Value = data[v]
		end
	end)

	spawn(function()
		if not dont_update then -- stop lag and shit yk
			RFunction:InvokeClient(plr,"DataChanged", data)
		end
	end)

	spawn(function()
		if update_pets then -- stop even more lag and shit yk
			RFunction:InvokeClient(plr,"DataChanged", "PETS", data["PETS"])
		end
	end)

	spawn(function()
		DataService:SetPlayerData(plr,data)
	end)
end

