-- Быстрая функция отправки патронов
local function fastSpamHatch()
    if autoHatch and selectedEgg ~= "" and REMOTE_EVENT then
        REMOTE_EVENT:FireServer("PurchaseEgg", selectedEgg, hatchType)
    end
end

EggSection:NewToggle("Auto Hatch", "Старт", function(s)
    autoHatch = s
    if s then
        task.spawn(function()
            while autoHatch do
                fastSpamHatch()
                -- Идеальный спам под обнуление дебаунса
                task.wait(0.05) 
            end
        end)
    end
end)

