-- === ИНИЦИАЛИЗАЦИЯ ===
local rs = game:GetService("ReplicatedStorage")
local lp = game.Players.LocalPlayer

-- Ремойты из оригинального серверного хендлера BGS
local REMOTE_EVENT = rs:FindFirstChild("NetworkRemoteEvent") or rs:FindFirstChild("RemoteEvent")
local REMOTE_FUNC = rs:FindFirstChild("NetworkRemoteFunction") or rs:FindFirstChild("RemoteFunction")

local EGGS_PATH = rs:FindFirstChild("Assets") and rs.Assets:FindFirstChild("Eggs") or rs:FindFirstChild("Eggs")
local PICKUPS = workspace:FindFirstChild("Pickups")

-- === НАСТРОЙКИ ОБХОДА СЕРВЕРА ===
local autoHatch = false
local selectedEgg, hatchType = "", "Single"

-- Время зависания сервера (с учетом взломанных пассов: 5.5 / 1.75 / 1.75 / 2 = ~0.9 сек)
local serverDebounceTime = 0.9 

-- === ХАКЕРСКИЙ ПЕРЕХВАТЧИК СЕРВЕРНОЙ ПАУЗЫ (ИСПРАВЛЕННЫЙ) ===
if REMOTE_FUNC and REMOTE_FUNC:IsA("RemoteFunction") then
    -- ВАЖНО: Больше НЕ считываем старый OnClientInvoke, чтобы движок Roblox не ругался!
    
    REMOTE_FUNC.OnClientInvoke = function(action, ...)
        if action == "DataChanged" and autoHatch then
            -- Ловим сервер на строчке InvokeClient! Заставляем его ждать, пока сгорит его дебаунс
            task.wait(serverDebounceTime) 
            return true -- Возвращаем серверу сигнал успеха, размораживая его поток
        end
        
        -- Для всех остальных системных вызовов возвращаем true, чтобы игра не зависала
        return true
    end
end

-- === ФУНКЦИЯ СТИЛЯ (КОТ + СТЕКЛО) ===
local function ApplyCustomStyle(id)
    local coreGui = game:GetService("CoreGui")
    for _, gui in pairs(coreGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui:FindFirstChild("Main") then
            local main = gui.Main
            if main:FindFirstChild("CustomBG") then main.CustomBG:Destroy() end
            local bg = Instance.new("ImageLabel", main)
            bg.Name = "CustomBG"
            bg.Size = UDim2.new(1, 0, 1, 0)
            bg.ZIndex = 0
            bg.BackgroundTransparency = 1
            bg.Image = "rbxassetid://" .. id
            bg.ImageTransparency = 0.2
            bg.ScaleType = Enum.ScaleType.Stretch
            Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 10)
            
            for _, child in pairs(main:GetDescendants()) do
                if child:IsA("Frame") or child:IsA("ScrollingFrame") then
                    child.BackgroundTransparency = 0.8
                    child.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
                elseif child:IsA("TextButton") then
                    if not child:FindFirstChild("UICorner") then Instance.new("UICorner", child).CornerRadius = UDim.new(0, 6) end
                    child.BackgroundTransparency = 0.5
                    child.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
                    child.TextColor3 = Color3.fromRGB(255, 255, 255)
                end
            end
        end
    end
end

