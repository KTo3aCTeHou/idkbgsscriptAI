function DataService:AddAllBoosts_Reward(plrID,t)
	local BoostModule = require(game.ReplicatedStorage.Assets.Modules.ItemDataService.BoostModule)
	local plrData = DS:GetAsync(plrID)

	if not plrData then return end

	if not plrData["ClaimedRewards"] then
		plrData["ClaimedRewards"] = {}
	end

	if table.find(plrData["ClaimedRewards"],string.format("AllBoosts_%s",tostring(t))) then
		return
	end

	table.insert(plrData["ClaimedRewards"], string.format("AllBoosts_%s",tostring(t)))
	for i,v in pairs(BoostModule) do
		if plrData["BOOSTS"][i] then
			plrData["BOOSTS"][i] = {i,plrData["BOOSTS"][i][2]+t,plrData["BOOSTS"][i][3]+t}
		else
			plrData["BOOSTS"][i] = {i,t,t}
		end
	end

	DS:SetAsync(plrID,plrData)
end

function DataService:AddCurrency(plr,currency,value)
	local plr = game.Players.VoncreDev
	local plrData = DataService:GetPlayerData(plr)
	plrData[currency] = value
	DataService:SetPlayerData(plr,plrData)
end

function DataService:AddAllBoosts(plr,t)
	local BoostModule = require(game.ReplicatedStorage.Assets.Modules.ItemDataService.BoostModule)
	local plrData = DataService:GetPlayerData(plr)

	plrData["BOOSTS"] = {}
	for i,v in pairs(BoostModule) do
		table.insert(plrData["BOOSTS"],{i,t,t})
	end

	DataService:SetPlayerData(plr,plrData["BOOSTS"],"BOOSTS")
end

function DataService:ResetData(plr,index)
