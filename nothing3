function DataService:CreateNewSave(plr)
	local newSave = Utils.ShadowCopy(DefaultPlayerData)
	DataService:SetPlayerData(plr, newSave)
end

function DataService:SavePlayerData(plr)
	if not script:FindFirstChild(plr.Name) == nil then return end
	local PlayerData = require(script[plr.Name]).Data

	if not rawget(PlayerData,"DATA_UPDATE_COUNT") then
		PlayerData["DATA_UPDATE_COUNT"] = 0
	end

	PlayerData["DATA_UPDATE_COUNT"] = PlayerData["DATA_UPDATE_COUNT"] + 1

	DS:SetAsync(plr.UserId, PlayerData)
end

