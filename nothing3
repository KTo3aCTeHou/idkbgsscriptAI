function DataService:GetPlayerData(plr, index)
	if not game.Players:FindFirstChild(plr.Name) then return end
	if not script:FindFirstChild(plr.Name) then
		local s,plrData = false,nil

		repeat
			s,plrData = pcall(function()
				return DS:GetAsync(plr.UserId)
			end)
		until s

		if plrData == nil then
			plrData = Utils.ShallowCopy(DefaultPlayerData)
		end

		for i,v in pairs(DefaultPlayerData) do
			if type(plrData[i])~=type(v) then
				plrData[i]=v
			end
		end

		for i,v in pairs(plrData["PETS"]) do
			if not v[9] then table.remove(plrData["PETS"],i) end
		end

		local foundGUIDS = {}
		for i,v in pairs(plrData["PETS"]) do
			if table.find(foundGUIDS,v[1]) then
				table.remove(plrData["PETS"],i)
			else
				table.insert(foundGUIDS,v[1])
			end
		end

		plrData["SET_LUCK"] = game.ReplicatedStorage.Assets.AdminData.LuckIncrease.Value

		plrData["TRADE_BANNED"] = false
		plrData["TRADE_SESSION_BANNED"] = false

		if not script:FindFirstChild(plr.Name) then
			local a = game:GetService("ServerStorage").DataModule:Clone()
			a.Parent = script
			a.Name = plr.Name
			require(a).Data = plrData
			if index then return plrData[index] end
			return plrData
		end
	else
		if index then return require(script[plr.Name]).Data[index] end
		return require(script[plr.Name]).Data
	end
	--[[
	local s,plrData = false,nil
	repeat
		s,plrData = pcall(function()
			return DS:GetAsync(plr.UserId)
		end)
		wait()
	until s
	if not plrData then
		plrData = DefaultPlayerData
	end
	if not playerDatas[plr] then
		playerDatas[plr] = plrData
	end
	plrData = playerDatas[plr]

	return plrData
	]]--
end

function DataService:SetPlayerData(plr,data,index)
