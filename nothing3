function DataService:AddAllGamepasses_Reward(plrID)
	local plrData = DS:GetAsync(plrID)
	if not plrData then return end

	if not plrData["ClaimedRewards"] then
		plrData["ClaimedRewards"] = {}
	end

	if table.find(plrData["ClaimedRewards"],"AllGamepasses") then
		return
	end

	table.insert(plrData["ClaimedRewards"], "AllGamepasses")

	plrData["AllGamepasses"] = true

	DS:SetAsync(plrID,plrData)
end

